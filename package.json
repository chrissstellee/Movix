{
  "name": "movix",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:contracts": "cargo build --manifest-path contracts/Cargo.toml --release --target wasm32v1-none",
    "dev": "turbo run dev",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare": "husky",
    "test": "turbo run test",
    "test:a11y": "pnpm --filter web test:a11y",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml",
    "test:e2e": "playwright test",
    "test:unit": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.43.0",
    "turbo": "^2.8.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.1.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.13",
      "@types/react-dom": "19.2.3"
    }
  }
}
