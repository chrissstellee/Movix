# Public client configuration. Replace with your Convex development URL locally.
NEXT_PUBLIC_CONVEX_URL=https://example.convex.cloud

# Server-only review switch. Production defaults to disabled.
MOVIX_ENABLE_FOUNDATION_SAMPLE=0

# Public authentication contract. Use exact deployed values.
MOVIX_STELLAR_NETWORK=testnet
MOVIX_HOME_DOMAIN=localhost:3000
MOVIX_WEB_AUTH_DOMAIN=localhost:3000
MOVIX_AUTH_ISSUER=http://localhost:3000
MOVIX_AUTH_AUDIENCE=movix-convex
MOVIX_AUTH_STORE_URL=https://example.convex.site
MOVIX_HORIZON_URL=https://horizon-testnet.stellar.org
MOVIX_JWT_ACTIVE_KID=local-rs256-1
MOVIX_JWT_RETIRING_PUBLIC_KEYS=[]

# Bounded lifetimes: 5-minute challenge, 10-minute JWT, 7-day session.
MOVIX_SEP10_CHALLENGE_SECONDS=300
MOVIX_JWT_ACCESS_SECONDS=600
MOVIX_SESSION_DAYS=7

# Server-only secrets. Generate distinct local values; never commit real values.
MOVIX_SEP10_SIGNING_SECRET=replace-with-a-local-testnet-secret
MOVIX_JWT_PRIVATE_KEY=replace-with-a-local-pkcs8-rsa-private-key
MOVIX_RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters
MOVIX_AUTH_STORE_SECRET=replace-with-a-different-32-character-secret

# Convex-deployment-only public JWT verification configuration. Local setup
# generates these with `pnpm auth:setup:local`.
MOVIX_AUTH_JWKS_URL=https://example.convex.site/.well-known/movix-auth-jwks.json
MOVIX_AUTH_PUBLIC_JWKS={"keys":[]}
